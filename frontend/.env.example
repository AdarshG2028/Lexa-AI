# The backend API. Must match the host and port it is served on, and that
# origin must appear in the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=http://localhost:8001

# Show the pronunciation analysis. Leave off unless the backend runs the
# phoneme model (PRONUNCIATION_PROVIDER=wav2vec2), which needs ~1.6 GB of RAM.
# Read at build time, so changing it on a host means redeploying.
VITE_ENABLE_PRONUNCIATION=false
