# Copy to .env and fill in. Never commit .env.

# Provider selection.
#   STT_PROVIDER / LLM_PROVIDER : groq | mock
#   TTS_PROVIDER                : groq | deepgram | mock
# "mock" runs the whole pipeline offline with deterministic fake providers,
# which is what the test suite uses and a safe fallback for demos.
STT_PROVIDER=groq
LLM_PROVIDER=groq
GRAMMAR_PROVIDER=groq
TTS_PROVIDER=groq

# Ordered fallbacks tried when TTS_PROVIDER fails (rate limit, no credit,
# outage). A conversation degrades to a lesser voice instead of dying.
# Providers with no credentials configured are skipped automatically.
TTS_FALLBACK_PROVIDERS=deepgram,mock

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model IDs. Verify the current list with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b

# TTS model and voice are a matched pair. Voice names are NOT portable between
# models: orpheus uses names like "troy", playai-tts uses "Fritz-PlayAI".
# Changing GROQ_TTS_MODEL means changing GROQ_TTS_VOICE too.
# Blank uses GROQ_LLM_MODEL.
GROQ_GRAMMAR_MODEL=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_TTS_FORMAT=wav

# Deepgram. Sign up at https://console.deepgram.com for a free credit.
# Voice names: https://developers.deepgram.com/docs/tts-models
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Request timeouts in seconds. The httpx default of 5s is too low for Whisper
# on a long clip or TTS on a paragraph.
PROVIDER_CONNECT_TIMEOUT=10
PROVIDER_READ_TIMEOUT=90

# How much of the conversation the model is shown each turn. Larger values
# cost more and add latency on every single turn of a long conversation.
CONVERSATION_HISTORY_TURNS=12
CONVERSATION_HISTORY_MAX_CHARS=8000

# A session with no activity for this long can no longer accept new turns.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Audio limits
MAX_UPLOAD_BYTES=25000000
MAX_AUDIO_SECONDS=300

# Session persistence. "database" survives restarts; "memory" does not.
SESSION_STORE=database
DATABASE_URL=sqlite+aiosqlite:///./data/voice_ai.db

# Local audio storage root (object storage can replace this later)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=data/audio

LOG_LEVEL=INFO
