# Copy to .env and fill in. Never commit .env.

# Provider selection.
#   STT_PROVIDER / LLM_PROVIDER : groq | mock
#   TTS_PROVIDER                : groq | deepgram | mock
# "mock" runs the whole pipeline offline with deterministic fake providers,
# which is what the test suite uses and a safe fallback for demos.
STT_PROVIDER=groq
LLM_PROVIDER=groq
VOCABULARY_PROVIDER=groq
# Phoneme-level pronunciation.
#   wav2vec2 : runs a 316M-parameter model locally; needs ~1.6 GB of RAM and
#              `uv sync --group pronunciation`
#   mock     : spelling-based and invents plausible findings. Tests only.
#   off      : the endpoint refuses. Use this on any deployment without the
#              model, so nothing fabricated can be shown to a learner.
PRONUNCIATION_PROVIDER=mock
PRONUNCIATION_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
# 0 lets torch decide; setting it to your core count roughly doubles speed.
PRONUNCIATION_TORCH_THREADS=0

# How much evidence before a phoneme pattern is reported. The defaults suit a
# full 5-8 minute conversation. For a short test clip set occurrences=1 and
# distinct_words=1, but expect accent and recogniser noise to appear as
# findings - on correct speech that is roughly 6 false positives per 20s.
PRONUNCIATION_MIN_OCCURRENCES=3
PRONUNCIATION_MIN_CONFIDENCE=0.55
PRONUNCIATION_MIN_DISTINCT_WORDS=2
# Keeps ~1.9 GB of model weights off the system drive.
HF_HOME=./data/models

GRAMMAR_PROVIDER=groq
# Deepgram, not Groq, is the default voice: Groq's TTS model (Orpheus) has a
# tight free-tier daily token cap - roughly one paragraph's worth - and a
# normal conversation can re-hit it, which swaps the voice mid-conversation
# as the fallback chain engages. Deepgram bills against a credit balance
# instead of a nightly reset, so it does not hit that ceiling under normal use.
TTS_PROVIDER=deepgram

# Ordered fallbacks tried when TTS_PROVIDER fails (rate limit, no credit,
# outage). A conversation degrades to a lesser voice instead of dying.
# Providers with no credentials configured are skipped automatically.
TTS_FALLBACK_PROVIDERS=groq,mock

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model IDs. Verify the current list with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_STT_MODEL=whisper-large-v3-turbo
# Pins the spoken language so Whisper never has to guess. Without this,
# auto-detection occasionally misreads English audio as another language's
# phonetics rather than transcribing it in English. Blank restores auto-detect.
GROQ_STT_LANGUAGE=en
GROQ_LLM_MODEL=openai/gpt-oss-120b
# gpt-oss is a reasoning model: part of every reply's token budget goes to
# hidden "thinking" before the visible answer (the app asks for low effort,
# but even that uses some). Too low a limit here can silently truncate or
# empty out the reply for a request that invites more thought.
GROQ_LLM_MAX_TOKENS=400

# TTS model and voice are a matched pair. Voice names are NOT portable between
# models: orpheus uses names like "troy", playai-tts uses "Fritz-PlayAI".
# Changing GROQ_TTS_MODEL means changing GROQ_TTS_VOICE too.
# Blank uses GROQ_LLM_MODEL.
GROQ_VOCABULARY_MODEL=
GROQ_GRAMMAR_MODEL=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_TTS_FORMAT=wav

# Deepgram. Sign up at https://console.deepgram.com for a free credit.
# Voice names: https://developers.deepgram.com/docs/tts-models
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Request timeouts in seconds. The httpx default of 5s is too low for Whisper
# on a long clip or TTS on a paragraph.
PROVIDER_CONNECT_TIMEOUT=10
PROVIDER_READ_TIMEOUT=90

# How much of the conversation the model is shown each turn. Larger values
# cost more and add latency on every single turn of a long conversation.
CONVERSATION_HISTORY_TURNS=12
CONVERSATION_HISTORY_MAX_CHARS=8000

# A session with no activity for this long can no longer accept new turns.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Audio limits
MAX_UPLOAD_BYTES=25000000
MAX_AUDIO_SECONDS=300

# Session persistence. "database" survives restarts; "memory" does not.
# SQLite suits local use. On a host whose disk is wiped on restart (Render's
# free tier), use managed Postgres instead and paste the URL as given:
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# The scheme and SSL parameters are translated for the async driver.
SESSION_STORE=database
DATABASE_URL=sqlite+aiosqlite:///./data/voice_ai.db

# Local audio storage root (object storage can replace this later)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=data/audio

# Browser origins allowed to call this API. The frontend dev server (bun/vite)
# runs on 8080, or the next free port if that is taken. Without its exact
# origin here the browser blocks every request.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Optional regex for origins that cannot be listed, chiefly Vercel preview
# deployments, which each get their own subdomain. Leave blank to disable.
#   CORS_ALLOWED_ORIGIN_REGEX=https://lexa-.*\.vercel\.app
CORS_ALLOWED_ORIGIN_REGEX=

# Per-IP limits over a sliding one-minute window. Turns and analyses are the
# calls that spend provider quota, so they are tighter. 0 turns a limit off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TURNS_PER_MINUTE=20
RATE_LIMIT_ANALYSIS_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120
# Reverse proxies in front of the app. 0 when run directly; 1 on Render, where
# the socket address is the proxy and the real client is in X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

LOG_LEVEL=INFO
